# ACL do broker da borda — espaço: centro
# %u = CN do certificado do cliente (identidade única por dispositivo)

# Agente de borda deste espaço: lê a telemetria, comanda atuadores e publica alarmes locais
user agente-centro
topic read dispositivos/+/telemetria
topic write dispositivos/+/comando
topic write borda/centro/alarme

# Dispositivos: cada um só publica a PRÓPRIA telemetria e só lê os PRÓPRIOS comandos
pattern write dispositivos/%u/telemetria
pattern read dispositivos/%u/comando
